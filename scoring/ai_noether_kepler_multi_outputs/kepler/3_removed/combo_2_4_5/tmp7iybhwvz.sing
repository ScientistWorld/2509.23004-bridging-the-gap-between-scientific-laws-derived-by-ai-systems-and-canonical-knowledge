LIB "primdec.lib";
ring baseR = 0, (Fc,Fg,w,m1,d1,m2,d2,p), dp;
poly a1 = m1*d1-m2*d2;
poly a2 = Fc - m2*d2*w^2;
ideal ii = a1, a2;
poly q1 = m1*m2*p^2-m1*d1*d2^2-m2*d1^2*d2-2*m2*d1*d2^2;
ideal targ = q1;
poly nz1 = m1;
poly nz2 = m2;
poly nz3 = d1;
poly nz4 = d2;
poly nz5 = p;
poly nz6 = d1+d2;
poly nonzero_product = nz1*nz2*nz3*nz4*nz5*nz6;
ideal encoded = ii + targ;
ideal nonzero_ideal = nonzero_product;
ideal saturated = sat(encoded, nonzero_ideal)[1];
list M1 = minAss(saturated);
print("=== SINGULAR_DECOMPOSITION_OUTPUT ===");
M1;
print("=== END_SINGULAR_DECOMPOSITION_OUTPUT ===");
quit;
