LIB "primdec.lib";
ring baseR = 0, (c,dt,v,F0,F,dt0,L0,L,m0,u0,m,u), dp;
poly a1 = F0*dt0 - 1;
poly a2 = -2*L0 + c*dt0;
poly a3 = -4*L0^2 + c^2*dt^2 - dt^2*v^2;
poly a4 = -m*u + m0*u0;
poly a5 = -dt*u + dt0*u0;
poly a6 = -2*L*c + c^2*dt - dt*v^2;
ideal ii = a1, a2, a3, a4, a5, a6;
poly q1 = -F^2*c^2 + F0^2*c^2 - F0^2*v^2;
poly q2 = -c^2*m^2*u0 + c^2*m0^2*u0 + m^2*u0*v^2;
poly q3 = -L^2*c^2 + L0^2*c^2 - L0^2*v^2;
ideal targ = q1, q2, q3;
list M1 = minAss(ii + targ);
print("=== SINGULAR_DECOMPOSITION_OUTPUT ===");
M1;
print("=== END_SINGULAR_DECOMPOSITION_OUTPUT ===");
quit;
