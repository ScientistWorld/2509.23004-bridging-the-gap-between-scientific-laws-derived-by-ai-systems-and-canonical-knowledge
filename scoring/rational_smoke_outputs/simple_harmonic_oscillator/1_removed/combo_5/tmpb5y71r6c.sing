LIB "primdec.lib";
ring baseR = 0, (ad,T,omega,theta,sintheta,d,g,L,j,Pi,Tj), dp;
poly a1 = ad - g*sintheta;
poly a2 = -L*theta + d;
poly a3 = -2*Pi + T*omega;
poly a4 = -ad + d*omega^2;
poly a5 = sintheta - theta;
ideal ii = a1, a2, a3, a4, a5;
poly q1 = -4*L*Pi^2*d*j^2 + Tj^2*d*g;
ideal targ = q1;
list M1 = minAss(ii + targ);
print("=== SINGULAR_DECOMPOSITION_OUTPUT ===");
M1;
print("=== END_SINGULAR_DECOMPOSITION_OUTPUT ===");
quit;
