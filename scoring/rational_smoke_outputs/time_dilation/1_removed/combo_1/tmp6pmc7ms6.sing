LIB "primdec.lib";
ring baseR = 0, (d,dt,dt0,L,c,F0,F,v), dp;
poly a1 = 4*L^2 - 4*d^2 - dt^2*v^2;
poly a2 = F0*dt0 - 1;
poly a3 = F*dt - 1;
poly a4 = -2*L + c*dt;
ideal ii = a1, a2, a3, a4;
poly q1 = -F^2*c^2 + F0^2*c^2 - F0^2*v^2;
ideal targ = q1;
list M1 = minAss(ii + targ);
print("=== SINGULAR_DECOMPOSITION_OUTPUT ===");
M1;
print("=== END_SINGULAR_DECOMPOSITION_OUTPUT ===");
quit;
